# Build artifacts
/c2tool
/c2tool.exe
/dist/
/build/out/
/build/assets/
/build/damaged-backup/
*.log

# Generated server payloads (produced by build/embed-payload.ps1)
/internal/embed/serverbin/*.gz

# Generated mimikatz shellcode (produced by build/build-mimikatz-shellcode.ps1)
#
# A build artifact, not source. Committing it would bake one donut version and
# one set of parameters into the repository, and a fixed shellcode blob is a
# signature every deployment would then share.
/internal/embed/mimikatz/*.bin

# donut and upx, if an operator vendors them beside the build scripts. Both are
# third-party binaries fetched at build time, not source: committing them would
# pin one version for every deployment and put a few hundred KB of someone
# else's executable in the history. The scripts look for them here and fail with
# an instruction when they are missing.
tools/donut/
tools/upx/

# Frontend
/frontend/node_modules/
/frontend/dist/
/web/dist/*
!/web/dist/.gitkeep

# Local state
/data/
*.dmp
zzout/